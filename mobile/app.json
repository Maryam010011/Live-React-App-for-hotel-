{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow LuxeStay to access your camera for property photos.",
          "photosPermission": "Allow LuxeStay to access your photo library for property uploads."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LuxeStay to access your camera."
        }
      ],
      "expo-file-system",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "e38cd198-901d-4c32-bb7c-7b7fb55af30b"
      }
    }
  }
}
